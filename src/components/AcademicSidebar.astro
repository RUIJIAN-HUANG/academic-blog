---
import Icon from './Icon.astro';
import { siteConfig, withBase } from '../data/site';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const navItems = [
  { path: '/', label: 'Biography', labelZh: '个人简介' },
  { path: '/about', label: 'About', labelZh: '关于我' },
  { path: '/research', label: 'Research', labelZh: '研究兴趣' },
  { path: '/blog', label: 'Notes', labelZh: '学习笔记' },
  { path: '/projects', label: 'Projects', labelZh: '项目' },
  { path: '/papers', label: 'Publications & reading', labelZh: '论文与阅读' },
  { path: '/cv', label: 'CV', labelZh: '简历' },
  { path: '/contact', label: 'Contact', labelZh: '联系方式' },
];

const isActive = (path: string) => {
  if (path === '/') return currentPath === '/';
  return currentPath === path || currentPath.startsWith(`${path}/`);
};

const availableLinks = siteConfig.links.filter((link) => link.href);
---

<aside class="academic-sidebar" aria-label="Profile and site navigation">
  <div class="profile-block">
    <div class="profile-avatar">
      <img src={withBase('/images/profile.jpg')} alt={`${siteConfig.name}（${siteConfig.nameZh}）`} loading="eager" decoding="async" />
    </div>
    <h2 class="profile-name">
      {siteConfig.name}
      <span class="profile-name-zh" lang="zh">（{siteConfig.nameZh}）</span>
    </h2>
    <p class="profile-affiliation">
      <span class="lang-en">{siteConfig.role}<br />{siteConfig.field}</span>
      <span class="lang-zh" lang="zh">{siteConfig.roleZh}<br />{siteConfig.fieldZh}</span>
    </p>
  </div>

  <a class="sidebar-follow" href={withBase('/contact')}>
    <span class="lang-en">Contact</span><span class="lang-zh" lang="zh">联系我</span>
  </a>

  <ul class="profile-links">
    <li class="profile-link-item">
      <span class="profile-link-icon" aria-hidden="true">⌖</span>
      <span class="lang-en">{siteConfig.location}</span>
      <span class="lang-zh" lang="zh">{siteConfig.locationZh}</span>
    </li>
    {availableLinks.map((link) => (
      <li class="profile-link-item">
        <a href={link.href!} target="_blank" rel="noreferrer">
          <span class="profile-link-icon" aria-hidden="true">
            {link.key === 'github' && <Icon name="github" size={14} />}
            {link.key === 'email' && <Icon name="mail" size={14} />}
            {link.key === 'scholar' && <Icon name="book" size={14} />}
            {link.key === 'orcid' && 'iD'}
          </span>
          <span class="lang-en">{link.label}</span>
          <span class="lang-zh" lang="zh">{link.labelZh}</span>
        </a>
      </li>
    ))}
    <li class="profile-link-item">
      <a href={withBase('/rss.xml')}>
        <span class="profile-link-icon" aria-hidden="true">↗</span>
        <span>RSS</span>
      </a>
    </li>
  </ul>

  <nav class="sidebar-nav" aria-label="Site sections">
    {navItems.map((item) => (
      <a class:list={{ 'sidebar-nav-link': true, active: isActive(item.path) }} href={withBase(item.path)} aria-current={isActive(item.path) ? 'page' : undefined}>
        <span class="lang-en">{item.label}</span>
        <span class="lang-zh" lang="zh">{item.labelZh}</span>
      </a>
    ))}
  </nav>
</aside>
