---
import Icon from './Icon.astro';
import { siteConfig, withBase } from '../data/site';

const iconFor: Record<string, 'github' | 'mail' | 'scholar' | 'orcid' | 'wechat' | 'whatsapp'> = {
  github: 'github',
  email: 'mail',
  scholar: 'scholar',
  orcid: 'orcid',
  wechat: 'wechat',
  whatsapp: 'whatsapp',
};
---

<aside class="profile-sidebar" aria-label="Personal profile">
  <a class="profile-photo-link" href={withBase('/')} aria-label={`${siteConfig.name} — home`}>
    <img class="profile-photo" src={withBase(siteConfig.profileImage)} alt={`${siteConfig.name} (${siteConfig.nameZh})`} width="192" height="288" loading="eager" decoding="async" />
  </a>

  <h2 class="profile-name">{siteConfig.name} <span>({siteConfig.nameZh})</span></h2>
  <p class="profile-institution">{siteConfig.institution}</p>

  <div class="profile-links">
    <p class="profile-link-row"><Icon name="location" size={18} /><span>{siteConfig.location}</span></p>
    {siteConfig.links.map((link) => (
      link.href ? (
        <a class="profile-link-row profile-social-link" href={link.href} target="_blank" rel="noreferrer">
          <Icon name={iconFor[link.key]} size={18} /><span>{link.label}</span>
        </a>
      ) : (
        <p class="profile-link-row">
          <Icon name={iconFor[link.key]} size={18} /><span>{link.label}</span>
        </p>
      )
    ))}
  </div>
</aside>
