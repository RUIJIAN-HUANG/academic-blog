---
import Icon from './Icon.astro';
---

<section class="search-panel" data-search-root aria-labelledby="search-title">
  <div class="search-header">
    <div>
      <p class="eyebrow">Search / 搜索</p>
      <h2 id="search-title" class="search-title">
        <span class="lang-en">Find a note</span>
        <span class="lang-zh" lang="zh">查找笔记</span>
      </h2>
    </div>
    <span class="search-shortcut">Pagefind</span>
  </div>
  <label class="search-input-wrap" for="site-search">
    <Icon name="search" size={19} />
    <input id="site-search" type="search" placeholder="Search articles, projects, and papers" data-search-input autocomplete="off" />
  </label>
  <p class="search-status" data-search-status aria-live="polite">
    <span class="lang-en">Search is indexed after a production build.</span>
    <span class="lang-zh" lang="zh">生产构建后会生成全文搜索索引。</span>
  </p>
  <div class="search-results" data-search-results></div>
</section>

<script>
  type PagefindItem = {
    url: string;
    excerpt?: string;
    meta?: { title?: string };
  };

  type PagefindResult = {
    data: () => Promise<PagefindItem>;
  };

  type PagefindModule = {
    search: (query: string) => Promise<{ results: PagefindResult[] }>;
  };

  const root = document.querySelector('[data-search-root]');

  if (root) {
    const input = root.querySelector('[data-search-input]');
    const status = root.querySelector('[data-search-status]');
    const results = root.querySelector('[data-search-results]');
    let pagefind: PagefindModule | undefined;
    let loading: Promise<PagefindModule> | undefined;

    const getPagefind = async () => {
      if (pagefind) return pagefind;
      if (!loading) {
        const url = new URL(`${import.meta.env.BASE_URL}pagefind/pagefind.js`, window.location.origin).href;
        loading = import(/* @vite-ignore */ url).then((module) => {
          pagefind = (module.default || module) as PagefindModule;
          return pagefind;
        });
      }
      return loading;
    };

    const clearResults = () => {
      if (results) results.innerHTML = '';
    };

    input?.addEventListener('input', async (event) => {
      const target = event.currentTarget as HTMLInputElement;
      const query = target.value.trim();
      clearResults();

      if (!query) {
        if (status) status.textContent = 'Search is indexed after a production build.';
        return;
      }

      if (status) status.textContent = 'Searching…';

      try {
        const index = await getPagefind();
        const search = await index.search(query);
        const items = await Promise.all(search.results.slice(0, 8).map((result) => result.data()));

        if (!items.length) {
          if (status) status.textContent = 'No matching pages.';
          return;
        }

        if (status) status.textContent = `${search.results.length} result${search.results.length === 1 ? '' : 's'}`;
        items.forEach((item) => {
          const link = document.createElement('a');
          link.className = 'search-result';
          link.href = item.url;
          link.innerHTML = `<span class="search-result-title"></span><span class="search-result-excerpt">${item.excerpt || ''}</span>`;
          link.querySelector<HTMLElement>('.search-result-title')!.textContent = item.meta?.title || item.url;
          results?.appendChild(link);
        });
      } catch {
        if (status) status.textContent = 'Search becomes available after running the production build.';
      }
    });
  }
</script>
