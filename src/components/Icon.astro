---
type IconName =
  | 'location'
  | 'mail'
  | 'scholar'
  | 'github'
  | 'orcid'
  | 'wechat'
  | 'whatsapp'
  | 'education'
  | 'news'
  | 'award'
  | 'external';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
}

const { name, size = 18, strokeWidth = 1.8 } = Astro.props;
---

<span class="icon" aria-hidden="true">
  {name === 'location' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 10.2c0 5.3-8 11-8 11s-8-5.7-8-11a8 8 0 1 1 16 0Z" />
      <circle cx="12" cy="10" r="2.4" />
    </svg>
  )}
  {name === 'mail' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="5" width="18" height="14" rx="1.5" />
      <path d="m3 7 9 6 9-6" />
    </svg>
  )}
  {name === 'scholar' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round">
      <path d="m3 9 9-5 9 5-9 5-9-5Z" />
      <path d="M7 11.2V15c2.8 2 7.2 2 10 0v-3.8M21 10v5" />
    </svg>
  )}
  {name === 'github' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 .7a11.3 11.3 0 0 0-3.58 22.02c.57.1.78-.25.78-.55v-2.16c-3.18.7-3.85-1.35-3.85-1.35-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.25 3.34.96.1-.74.4-1.25.73-1.54-2.54-.29-5.2-1.27-5.2-5.65 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.45.11-3.03 0 0 .96-.31 3.12 1.17a10.8 10.8 0 0 1 5.68 0c2.16-1.48 3.12-1.17 3.12-1.17.62 1.58.23 2.74.11 3.03.73.8 1.18 1.82 1.18 3.07 0 4.39-2.67 5.35-5.22 5.64.41.35.78 1.04.78 2.1v3.11c0 .3.2.66.79.55A11.3 11.3 0 0 0 12 .7Z" />
    </svg>
  )}
  {name === 'orcid' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="9" />
      <path d="M9 8v8M12 8h1.5a4 4 0 1 1 0 8H12V8Z" />
    </svg>
  )}
  {name === 'wechat' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round">
      <path d="M6.8 16.8C3.9 16.5 2 14.8 2 12.5c0-2.6 2.6-4.7 5.8-4.7s5.8 2.1 5.8 4.7c0 .7-.2 1.4-.6 2l1 2.1-2.6-1.2c-.7.3-1.5.5-2.4.5Z" />
      <path d="M13.2 17.9c.8.4 1.8.6 2.8.6 3.2 0 5.8-2.1 5.8-4.7s-2.6-4.7-5.8-4.7c-.5 0-1 .1-1.5.2" />
      <path d="M6.5 12.5h.1M9.7 12.5h.1M15.6 13.8h.1M18.5 13.8h.1" />
    </svg>
  )}
  {name === 'whatsapp' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 11.5a8 8 0 0 1-11.9 7L4 20l1.5-4A8 8 0 1 1 20 11.5Z" />
      <path d="M9 8.5c.3-.4.7-.3.9.1l.6 1.2c.1.3.1.5-.1.7l-.5.5c.5 1 1.3 1.8 2.3 2.3l.5-.5c.2-.2.4-.2.7-.1l1.2.6c.4.2.5.6.1.9l-.4.4c-.4.4-1 .5-1.5.3-2.6-.9-4.5-2.8-5.4-5.4-.2-.5-.1-1.1.3-1.5l.4-.4Z" />
    </svg>
  )}
  {name === 'education' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor">
      <path d="m2 9 10-5 10 5-10 5L2 9Zm4 3.2V16c3.5 2.8 8.5 2.8 12 0v-3.8l-6 3-6-3ZM21 10v6h1v-6h-1Z" />
    </svg>
  )}
  {name === 'news' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="4" width="18" height="16" rx="1.5" />
      <path d="M7 8h5M7 12h5M7 16h3M15 8h3v8h-3z" />
    </svg>
  )}
  {name === 'award' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="8" r="4.5" />
      <path d="m8.7 11.2-1 8 4.3-2.3 4.3 2.3-1-8" />
    </svg>
  )}
  {name === 'external' && (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 5h5v5M19 5l-8 8M18 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
    </svg>
  )}
</span>
