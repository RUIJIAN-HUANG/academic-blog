---
import { siteConfig, withBase } from '../data/site';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const publicationsPath = '/publications';
const isPublicationsPage = currentPath === publicationsPath || currentPath.startsWith(`${publicationsPath}/`);
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="site-brand" href={withBase('/')} aria-label={`${siteConfig.name} — home`}>
      {siteConfig.brand}
    </a>
    <nav class="site-nav" aria-label="Primary navigation">
      <a class:list={{ active: isPublicationsPage }} href={withBase(publicationsPath)} aria-current={isPublicationsPage ? 'page' : undefined}>Publications</a>
    </nav>
  </div>
</header>
