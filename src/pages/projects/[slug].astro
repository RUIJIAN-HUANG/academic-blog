---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getPapers, getProjects, slugFor, type Project } from '../../lib/content';
import { withBase } from '../../data/site';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: slugFor(project) },
    props: { project },
  }));
}

const { project } = Astro.props as { project: Project };
const { Content } = await render(project);
const papers = await getPapers();
const relatedPapers = papers.filter((paper) => project.data.relatedPapers.includes(slugFor(paper)));
const imageHref = project.data.image ? (project.data.image.startsWith('http') ? project.data.image : withBase(project.data.image)) : null;
---

<BaseLayout title={project.data.title} description={project.data.summary}>
  <article class="project-page" data-pagefind-body>
    <section class="page-header">
      <div class="container-shell">
        <a class="back-link" href={withBase('/projects')}><Icon name="arrow" size={15} /><span class="lang-en">All projects</span><span class="lang-zh" lang="zh">全部项目</span></a>
        <div class="detail-header">
          <div class="card-meta" style="margin-top: 1.25rem;">
            <span class="status-pill"><span class="status-dot" aria-hidden="true"></span><span class="lang-en">{project.data.status}</span><span class="lang-zh" lang="zh">{project.data.statusZh}</span></span>
            {project.data.sample && <span class="sample-badge"><span class="lang-en">Sample record</span><span class="lang-zh" lang="zh">示例记录</span></span>}
          </div>
          <h1><span class="lang-en">{project.data.title}</span><span class="lang-zh" lang="zh">{project.data.titleZh}</span></h1>
          <p class="detail-summary"><span class="lang-en">{project.data.summary}</span><span class="lang-zh" lang="zh">{project.data.summaryZh}</span></p>
        </div>
      </div>
    </section>

    <section class="page-section tight">
      <div class="container-shell detail-grid">
        <div class="prose detail-body">
          <Content />

          <section class="detail-section" aria-labelledby="project-stack-title">
            <h2 id="project-stack-title"><span class="lang-en">Technology</span><span class="lang-zh" lang="zh">技术栈</span></h2>
            <div class="stack-list">
              {project.data.stack.map((item) => <span class="stack-item">{item}</span>)}
            </div>
          </section>

          <section class="detail-section" aria-labelledby="project-outcomes-title">
            <h2 id="project-outcomes-title"><span class="lang-en">Outcomes</span><span class="lang-zh" lang="zh">成果</span></h2>
            <ul>
              {project.data.outcomes.map((outcome) => <li>{outcome}</li>)}
            </ul>
          </section>

          {relatedPapers.length > 0 && (
            <section class="detail-section" aria-labelledby="project-papers-title">
              <h2 id="project-papers-title"><span class="lang-en">Related reading</span><span class="lang-zh" lang="zh">相关阅读</span></h2>
              <ul>
                {relatedPapers.map((paper) => <li><a href={withBase(`/papers/${slugFor(paper)}/`)}><span class="lang-en">{paper.data.title}</span><span class="lang-zh" lang="zh">{paper.data.titleZh}</span></a></li>)}
              </ul>
            </section>
          )}
        </div>

        <aside class="detail-side-card">
          {imageHref && <img class="project-image detail-project-image" src={imageHref} alt={project.data.title} loading="lazy" decoding="async" />}
          <p class="side-label"><span class="lang-en">Project links</span><span class="lang-zh" lang="zh">项目链接</span></p>
          {project.data.github ? <a class="button-link primary" href={project.data.github} target="_blank" rel="noreferrer">GitHub <Icon name="external" size={15} /></a> : <p class="placeholder-note" style="margin-top: 0.8rem;"><span class="lang-en">Repository link to be added.</span><span class="lang-zh" lang="zh">代码仓库链接待补充。</span></p>}
          {project.data.demo ? <a class="button-link" href={project.data.demo} target="_blank" rel="noreferrer">Demo <Icon name="external" size={15} /></a> : <p class="placeholder-note" style="margin-top: 0.7rem;"><span class="lang-en">Demo link to be added.</span><span class="lang-zh" lang="zh">演示链接待补充。</span></p>}
        </aside>
      </div>
    </section>
  </article>
</BaseLayout>
