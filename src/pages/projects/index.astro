---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<BaseLayout title="Projects" description="Project workspaces and implementation records by Ruijian Huang.">
  <section class="page-header">
    <div class="container-shell">
      <p class="eyebrow">Projects / 04</p>
      <h1><span class="lang-en">Projects</span><span class="lang-zh" lang="zh">项目</span></h1>
      <p class="page-intro">
        <span class="lang-en">Project records keep background, technical direction, evidence, and links together. Entries marked as samples are templates waiting for verified details.</span>
        <span class="lang-zh" lang="zh">项目记录将背景、技术方案、证据与链接放在一起。标记为示例的条目是等待补充真实信息的模板。</span>
      </p>
    </div>
  </section>

  <section class="page-section tight" data-pagefind-body>
    <div class="container-shell">
      <div class="project-grid">
        {projects.map((project, index) => <ProjectCard project={project} index={index + 1} />)}
      </div>
    </div>
  </section>
</BaseLayout>
