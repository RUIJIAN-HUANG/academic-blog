---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../data/site';
---

<BaseLayout title="Page not found" description="The requested page could not be found." noindex>
  <section class="page-section">
    <div class="container-shell" style="max-width: 46rem; text-align: center;">
      <p class="eyebrow">404</p>
      <h1 style="margin: 0.8rem 0 0; font-size: clamp(3rem, 10vw, 6rem); letter-spacing: -0.08em;">Not found</h1>
      <p class="page-intro" style="margin-inline: auto;">
        <span class="lang-en">This page may have moved or the link may be incomplete.</span>
        <span class="lang-zh" lang="zh">页面可能已经移动，或者链接不完整。</span>
      </p>
      <a class="button-link primary" style="margin-top: 1.4rem;" href={withBase('/')}><span class="lang-en">Return home</span><span class="lang-zh" lang="zh">返回首页</span></a>
    </div>
  </section>
</BaseLayout>
