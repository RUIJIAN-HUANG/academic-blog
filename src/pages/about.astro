---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, cvPlaceholders, withBase } from '../data/site';
---

<BaseLayout title="About" description="Background, education, and long-term goals for Ruijian Huang.">
  <section class="page-header">
    <div class="container-shell">
      <p class="eyebrow">About / 01</p>
      <h1><span class="lang-en">About me</span><span class="lang-zh" lang="zh">关于我</span></h1>
      <p class="page-intro">
        <span class="lang-en">A concise profile that separates confirmed information from details still waiting to be added.</span>
        <span class="lang-zh" lang="zh">一份区分已确认信息与待补充内容的个人简介。</span>
      </p>
    </div>
  </section>

  <section class="page-section tight">
    <div class="container-shell about-grid">
      <div class="about-copy">
        <p>
          <span class="lang-en">I am {siteConfig.name}, a {siteConfig.role.toLowerCase()} studying {siteConfig.field}. My current interest is {siteConfig.interest.toLowerCase()}.</span>
          <span class="lang-zh" lang="zh">我是{siteConfig.nameZh}，一名学习{siteConfig.fieldZh}的{siteConfig.roleZh}。当前关注方向是{siteConfig.interestZh}。</span>
        </p>
        <p>
          <span class="lang-en">This page is intentionally modest: it is a place to add verified education, research experience, and longer-term goals without filling the gaps with assumptions.</span>
          <span class="lang-zh" lang="zh">这个页面保持克制：它用于逐步添加经过核实的教育经历、研究经历与长期目标，不用假设填补空白。</span>
        </p>
        <p>
          <span class="lang-en">For the full record of work in progress, visit the <a href={withBase('/blog')}>notes</a>, <a href={withBase('/projects')}>projects</a>, and <a href={withBase('/papers')}>reading list</a>.</span>
          <span class="lang-zh" lang="zh">如需查看进行中的记录，可以访问<a href={withBase('/blog')}>笔记</a>、<a href={withBase('/projects')}>项目</a>与<a href={withBase('/papers')}>阅读列表</a>。</span>
        </p>
      </div>

      <dl class="fact-list">
        <div>
          <dt><span class="lang-en">Name</span><span class="lang-zh" lang="zh">姓名</span></dt>
          <dd>{siteConfig.name} / {siteConfig.nameZh}</dd>
        </div>
        <div>
          <dt><span class="lang-en">Role</span><span class="lang-zh" lang="zh">身份</span></dt>
          <dd><span class="lang-en">{siteConfig.role}</span><span class="lang-zh" lang="zh">{siteConfig.roleZh}</span></dd>
        </div>
        <div>
          <dt><span class="lang-en">Field</span><span class="lang-zh" lang="zh">专业方向</span></dt>
          <dd><span class="lang-en">{siteConfig.field}</span><span class="lang-zh" lang="zh">{siteConfig.fieldZh}</span></dd>
        </div>
        <div>
          <dt><span class="lang-en">Primary interest</span><span class="lang-zh" lang="zh">主要兴趣</span></dt>
          <dd><span class="lang-en">{siteConfig.interest}</span><span class="lang-zh" lang="zh">{siteConfig.interestZh}</span></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="page-section tight" aria-labelledby="education-title">
    <div class="container-shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Background / 02</p>
          <h2 id="education-title"><span class="lang-en">Education & experience</span><span class="lang-zh" lang="zh">教育与经历</span></h2>
        </div>
      </div>
      <div class="timeline">
        <div class="timeline-item">
          <div class="timeline-date"><span class="lang-en">Education</span><span class="lang-zh" lang="zh">教育经历</span></div>
          <div>
            <p class="timeline-title"><span class="lang-en">{cvPlaceholders.education}</span><span class="lang-zh" lang="zh">{cvPlaceholders.educationZh}</span></p>
            <p class="timeline-note"><span class="lang-en">Add the institution, degree, dates, and any verified focus.</span><span class="lang-zh" lang="zh">请补充学校、学位、时间与经过核实的研究重点。</span></p>
          </div>
        </div>
        <div class="timeline-item">
          <div class="timeline-date"><span class="lang-en">Research</span><span class="lang-zh" lang="zh">研究经历</span></div>
          <div>
            <p class="timeline-title"><span class="lang-en">{cvPlaceholders.research}</span><span class="lang-zh" lang="zh">{cvPlaceholders.researchZh}</span></p>
            <p class="timeline-note"><span class="lang-en">Add only roles, supervision, and dates that can be documented.</span><span class="lang-zh" lang="zh">仅添加可以被记录或证明的角色、指导关系与时间。</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section tight" aria-labelledby="goals-title">
    <div class="container-shell detail-grid">
      <div>
        <p class="eyebrow">Direction / 03</p>
        <h2 id="goals-title" class="section-heading-title"><span class="lang-en">Long-term goals</span><span class="lang-zh" lang="zh">长期目标</span></h2>
        <p class="section-description">
          <span class="lang-en">[Add a short, specific statement about the problems you hope to work on and the kind of research practice you want to develop.]</span>
          <span class="lang-zh" lang="zh">[请补充希望长期研究的问题，以及希望形成的研究实践。]</span>
        </p>
      </div>
      <div class="callout">
        <p><span class="lang-en">A useful profile can stay incomplete while it is honest. Update this page when a fact becomes stable enough to cite.</span><span class="lang-zh" lang="zh">一份真实的简介可以暂时不完整，但应当保持诚实。等信息足够稳定、可以引用时再更新。</span></p>
      </div>
    </div>
  </section>
</BaseLayout>
