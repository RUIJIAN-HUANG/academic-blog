---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { cvPlaceholders, siteConfig, withBase } from '../data/site';
---

<BaseLayout title="CV" description="Curriculum vitae and verified academic record for Ruijian Huang.">
  <section class="page-header">
    <div class="container-shell cv-header">
      <div>
        <p class="eyebrow">CV / 06</p>
        <h1><span class="lang-en">Curriculum vitae</span><span class="lang-zh" lang="zh">个人简历</span></h1>
        <p class="page-intro">
          <span class="lang-en">A concise academic record. The visible entries remain placeholders until the corresponding details are verified.</span>
          <span class="lang-zh" lang="zh">一份简洁的学术履历。相应信息核实前，页面中的条目保持为占位内容。</span>
        </p>
      </div>
      <a class="button-link cv-download" href={withBase('/cv/ruijian-huang-cv-template.pdf')} download>
        <Icon name="download" size={16} />
        <span class="lang-en">Download PDF</span><span class="lang-zh" lang="zh">下载 PDF</span>
      </a>
    </div>
  </section>

  <section class="page-section tight" data-pagefind-body>
    <div class="container-shell cv-grid">
      <div>
        <section class="cv-section">
          <h2><span class="lang-en">Education</span><span class="lang-zh" lang="zh">教育经历</span></h2>
          <p class="cv-placeholder"><span class="lang-en">{cvPlaceholders.education}</span><span class="lang-zh" lang="zh">{cvPlaceholders.educationZh}</span></p>
        </section>

        <section class="cv-section">
          <h2><span class="lang-en">Research experience</span><span class="lang-zh" lang="zh">研究经历</span></h2>
          <p class="cv-placeholder"><span class="lang-en">{cvPlaceholders.research}</span><span class="lang-zh" lang="zh">{cvPlaceholders.researchZh}</span></p>
        </section>

        <section class="cv-section">
          <h2><span class="lang-en">Selected projects</span><span class="lang-zh" lang="zh">精选项目</span></h2>
          <p class="cv-placeholder"><span class="lang-en">[Add verified projects, roles, links, and dates]</span><span class="lang-zh" lang="zh">[请补充经过核实的项目、角色、链接与时间]</span></p>
        </section>

        <section class="cv-section">
          <h2><span class="lang-en">Publications & talks</span><span class="lang-zh" lang="zh">论文与报告</span></h2>
          <p class="cv-placeholder"><span class="lang-en">[Add publications, preprints, reports, or talks with traceable links]</span><span class="lang-zh" lang="zh">[请补充带有可追溯链接的论文、预印本、报告或演讲]</span></p>
        </section>

        <section class="cv-section">
          <h2><span class="lang-en">Skills</span><span class="lang-zh" lang="zh">技能</span></h2>
          <div class="skill-grid">
            {cvPlaceholders.skills.map((skill, index) => <span class="skill-item"><span class="lang-en">{skill}</span><span class="lang-zh" lang="zh">{cvPlaceholders.skillsZh[index]}</span></span>)}
          </div>
        </section>
      </div>

      <aside class="cv-side">
        <p><strong>{siteConfig.name}</strong> / {siteConfig.nameZh}</p>
        <p><span class="lang-en">{siteConfig.role} · {siteConfig.field}</span><span class="lang-zh" lang="zh">{siteConfig.roleZh} · {siteConfig.fieldZh}</span></p>
        <p><span class="lang-en">Research interests: {siteConfig.researchSummary}</span><span class="lang-zh" lang="zh">研究兴趣：{siteConfig.researchSummaryZh}</span></p>
        <p><span class="lang-en">Replace this summary with a verified two- or three-sentence profile.</span><span class="lang-zh" lang="zh">请将此处替换为经过核实的两至三句个人简介。</span></p>
      </aside>
    </div>
  </section>
</BaseLayout>
