---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { awards, education, news, siteConfig } from '../data/site';
---

<BaseLayout description={siteConfig.description}>
  <article class="homepage" itemscope itemtype="https://schema.org/Person">
    <section class="content-section biography-section">
      <h1>Biography</h1>
      <p class="biography-copy" itemprop="description">
        {siteConfig.biography}
      </p>
      {siteConfig.cvHref && (
        <p class="inline-link-row">
          You can find my CV here: <a href={siteConfig.cvHref}>Ruijian Huang’s Curriculum Vitae</a>.
        </p>
      )}
    </section>

    {education.length > 0 && (
      <section class="content-section" aria-labelledby="education-title">
        <h2 id="education-title"><Icon name="education" size={25} /> <span>Education</span></h2>
        <div class="section-rule" aria-hidden="true"></div>
        <ul class="record-list education-list">
          {education.map((entry) => (
            <li>
              <p class="record-title"><strong>{entry.institution}</strong> <span>({entry.dates})</span></p>
              <p class="record-detail">{entry.program} — <em>{entry.college}</em></p>
            </li>
          ))}
        </ul>
      </section>
    )}

    {news.length > 0 && (
      <section class="content-section" aria-labelledby="news-title">
        <h2 id="news-title"><Icon name="news" size={25} /> <span>News</span></h2>
        <div class="section-rule" aria-hidden="true"></div>
        <ul class="bullet-list">
          {news.map((item) => (
            <li>
              <strong>[{item.date}]</strong>{' '}
              {item.href ? <a href={item.href} target="_blank" rel="noreferrer">{item.text}</a> : item.text}
            </li>
          ))}
        </ul>
      </section>
    )}

    {awards.length > 0 && (
      <section class="content-section" aria-labelledby="awards-title">
        <h2 id="awards-title"><Icon name="award" size={25} /> <span>Awards &amp; Honors</span></h2>
        <div class="section-rule" aria-hidden="true"></div>
        <ul class="bullet-list">
          {awards.map((award) => (
            <li>
              {award.href ? <a href={award.href} target="_blank" rel="noreferrer"><strong>{award.title}</strong></a> : <strong>{award.title}</strong>}, {award.organization}, {award.year}
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
