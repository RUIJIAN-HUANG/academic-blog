---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Search from '../../components/Search.astro';
import { blogCategories } from '../../data/site';
import { getPosts } from '../../lib/content';

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<BaseLayout title="Blog" description="Algorithms, AI learning notes, paper reading, experiment reviews, and research methods.">
  <section class="page-header">
    <div class="container-shell">
      <p class="eyebrow">Notes / 03</p>
      <h1><span class="lang-en">The blog</span><span class="lang-zh" lang="zh">博客</span></h1>
      <p class="page-intro">
        <span class="lang-en">A searchable archive for algorithms, AI learning notes, paper reading, experiment reviews, and research practice.</span>
        <span class="lang-zh" lang="zh">一个用于记录算法、AI 学习、论文阅读、实验复盘与研究实践的可搜索档案。</span>
      </p>
    </div>
  </section>

  <section class="page-section tight" data-pagefind-body>
    <div class="container-shell">
      <div class="blog-tools">
        <div class="filter-panel" aria-label="Blog filters">
          <div class="filter-row">
            <span class="filter-label"><span class="lang-en">Category</span><span class="lang-zh" lang="zh">分类</span></span>
            <label class="sr-only" for="category-filter">Filter by category</label>
            <select id="category-filter" class="filter-select" data-category-filter>
              <option value="">All categories / 全部分类</option>
              {blogCategories.map((category) => <option value={category.value}>{category.label}</option>)}
            </select>
          </div>
          <div class="filter-row" style="margin-top: 0.75rem;">
            <span class="filter-label"><span class="lang-en">Tag</span><span class="lang-zh" lang="zh">标签</span></span>
            <div class="filter-row" data-tag-filters>
              <button class="filter-button active" type="button" data-tag-filter="">All / 全部</button>
              {tags.map((tag) => <button class="filter-button" type="button" data-tag-filter={tag}>#{tag}</button>)}
            </div>
            <button class="filter-button clear-button" type="button" data-clear-filters><span class="lang-en">Reset</span><span class="lang-zh" lang="zh">重置</span></button>
          </div>
        </div>
        <Search />
      </div>

      <div class="section-heading" style="margin-top: 2.6rem;">
        <div>
          <p class="eyebrow">Archive</p>
          <h2><span class="lang-en">All notes</span><span class="lang-zh" lang="zh">全部笔记</span></h2>
        </div>
        <span class="section-link" style="cursor: default; border-bottom-color: transparent;">
          <span class="lang-en">{posts.length} entries</span><span class="lang-zh" lang="zh">{posts.length} 篇</span>
        </span>
      </div>

      <div class="post-grid" data-post-grid>
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      <div class="filter-empty" data-filter-empty>
        <span class="lang-en">No notes match these filters.</span><span class="lang-zh" lang="zh">没有符合筛选条件的笔记。</span>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const categoryFilter = document.querySelector<HTMLSelectElement>('[data-category-filter]');
  const tagFilters = [...document.querySelectorAll<HTMLButtonElement>('[data-tag-filter]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-post-card]')];
  const emptyState = document.querySelector('[data-filter-empty]');
  const clearButton = document.querySelector('[data-clear-filters]');
  const requestedTag = new URLSearchParams(window.location.search).get('tag') || '';

  const setActiveTag = (tag: string) => {
    tagFilters.forEach((button) => button.classList.toggle('active', button.dataset.tagFilter === tag));
  };

  const applyFilters = () => {
    const category = categoryFilter?.value || '';
    const tag = tagFilters.find((button) => button.classList.contains('active'))?.dataset.tagFilter || '';
    let visible = 0;

    cards.forEach((card) => {
      const matchesCategory = !category || card.dataset.category === category;
      const cardTags = card.dataset.tags?.split(',') || [];
      const matchesTag = !tag || cardTags.includes(tag);
      const show = matchesCategory && matchesTag;
      card.hidden = !show;
      if (show) visible += 1;
    });

    emptyState?.classList.toggle('is-visible', visible === 0);
  };

  if (requestedTag && tagFilters.some((button) => button.dataset.tagFilter === requestedTag)) {
    setActiveTag(requestedTag);
  }

  categoryFilter?.addEventListener('change', applyFilters);
  tagFilters.forEach((button) => button.addEventListener('click', () => {
    setActiveTag(button.dataset.tagFilter || '');
    applyFilters();
  }));
  clearButton?.addEventListener('click', () => {
    if (categoryFilter) categoryFilter.value = '';
    setActiveTag('');
    applyFilters();
    window.history.replaceState({}, '', window.location.pathname);
  });
  applyFilters();
</script>
