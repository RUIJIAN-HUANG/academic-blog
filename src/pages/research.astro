---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { researchTopics, withBase } from '../data/site';
import { getPosts, slugFor } from '../lib/content';

const posts = await getPosts();
---

<BaseLayout title="Research interests" description="Research themes and editorial lenses for embodied intelligence and robot learning.">
  <section class="page-header">
    <div class="container-shell">
      <p class="eyebrow">Research / 02</p>
      <h1><span class="lang-en">Research interests</span><span class="lang-zh" lang="zh">研究兴趣</span></h1>
      <p class="page-intro">
        <span class="lang-en">The first two themes reflect the current profile. The remaining lenses keep the archive navigable while their exact scope is still open.</span>
        <span class="lang-zh" lang="zh">前两个主题来自当前个人定位；其余主题用于保持档案可导航，具体范围仍待补充。</span>
      </p>
    </div>
  </section>

  <section class="page-section tight">
    <div class="container-shell topic-grid">
      {researchTopics.map((topic) => {
        const related = posts.filter((post) => topic.tags.some((tag) => post.data.tags.includes(tag))).slice(0, 2);
        return (
          <article class="topic-card" data-accent={topic.accent}>
            <p class="topic-number">{topic.number}</p>
            <h2 class="topic-title"><span class="lang-en">{topic.title}</span><span class="lang-zh" lang="zh">{topic.titleZh}</span></h2>
            <p class="topic-description"><span class="lang-en">{topic.description}</span><span class="lang-zh" lang="zh">{topic.descriptionZh}</span></p>
            <div class="topic-links">
              {related.map((post) => <a class="topic-link" href={withBase(`/blog/${slugFor(post)}/`)}><span class="lang-en">{post.data.title}</span><span class="lang-zh" lang="zh">{post.data.titleZh}</span></a>)}
              {!related.length && <span class="placeholder-note"><span class="lang-en">Notes to be linked</span><span class="lang-zh" lang="zh">待关联笔记</span></span>}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="page-section tight">
    <div class="container-shell callout">
      <p>
        <span class="lang-en">Research topics are navigation aids, not claims of expertise. Each future entry should make its evidence boundary clear.</span>
        <span class="lang-zh" lang="zh">研究主题是导航工具，不等同于专业能力声明。未来每篇内容都应明确证据边界。</span>
      </p>
      <a class="text-link" href={withBase('/blog')}><span class="lang-en">Read the archive</span><span class="lang-zh" lang="zh">阅读文章档案</span><Icon name="arrow" size={16} /></a>
    </div>
  </section>
</BaseLayout>
