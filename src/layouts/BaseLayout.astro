---
import Header from '../components/Header.astro';
import AcademicSidebar from '../components/AcademicSidebar.astro';
import { siteConfig, withBase } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  noindex = false,
} = Astro.props;

const pageTitle = title === siteConfig.title ? title : `${title} — ${siteConfig.name}`;
const resolvedSiteUrl = Astro.site?.toString() ?? siteConfig.siteUrl;
const canonicalUrl = new URL(Astro.url.pathname, resolvedSiteUrl).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.name,
  alternateName: siteConfig.nameZh,
  jobTitle: siteConfig.role,
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: siteConfig.institution,
  },
  description: siteConfig.description,
  url: resolvedSiteUrl,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <div class="site-layout">
        <AcademicSidebar />
        <div class="site-main">
          <slot />
        </div>
      </div>
    </main>
  </body>
</html>
