---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { siteConfig, withBase } from '../data/site';
import { formatDate, getReadingTime, slugFor, type BlogPost } from '../lib/content';

interface Props {
  post: BlogPost;
  related?: BlogPost[];
}

const { post, related = [] } = Astro.props;
const { data } = post;
const resolvedSiteUrl = Astro.site?.toString() ?? siteConfig.siteUrl;
const canonicalUrl = new URL(Astro.url.pathname, resolvedSiteUrl).toString();
---

<BaseLayout title={data.title} description={data.summary}>
  <article class="article-page" data-pagefind-body>
    <div class="container-shell article-shell">
      <header class="article-header">
        <a class="back-link" href={withBase('/blog')}><Icon name="arrow" size={15} /><span class="lang-en">All notes</span><span class="lang-zh" lang="zh">全部笔记</span></a>
        <div class="article-meta">
          <span><span class="lang-en">{data.category}</span><span class="lang-zh" lang="zh">{data.categoryZh}</span></span>
          <span class="card-dot" aria-hidden="true"></span>
          <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
          <span class="card-dot" aria-hidden="true"></span>
          <span>{getReadingTime(post)} min <span class="lang-en">read</span><span class="lang-zh" lang="zh">阅读</span></span>
          {data.math && <span class="article-flag">∑</span>}
        </div>
        {data.sample && <p class="sample-note"><span class="lang-en">Sample content — replace with verified personal notes before publishing.</span><span class="lang-zh" lang="zh">示例内容——正式发布前请替换为经过核实的个人笔记。</span></p>}
        <h1 class="article-title">
          <span class="lang-en">{data.title}</span>
          <span class="lang-zh" lang="zh">{data.titleZh}</span>
        </h1>
        <p class="article-summary">
          <span class="lang-en">{data.summary}</span>
          <span class="lang-zh" lang="zh">{data.summaryZh}</span>
        </p>
        <div class="tag-list article-tags">
          {data.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </header>

      <div class="article-layout">
        <aside class="article-aside" aria-label="Article information">
          <div class="aside-block">
            <p class="aside-label"><span class="lang-en">On this page</span><span class="lang-zh" lang="zh">本文目录</span></p>
            <nav class="toc" data-toc aria-label="Table of contents"></nav>
          </div>
          <div class="aside-block aside-source">
            <p class="aside-label"><span class="lang-en">Updated</span><span class="lang-zh" lang="zh">更新于</span></p>
            <p>{formatDate(data.updated ?? data.date)}</p>
          </div>
        </aside>

        <div class="prose article-prose">
          <slot />
        </div>
      </div>

      {related.length > 0 && (
        <section class="related-section" aria-labelledby="related-title">
          <div class="section-heading compact-heading">
            <div>
              <p class="eyebrow">Continue reading</p>
              <h2 id="related-title"><span class="lang-en">Related notes</span><span class="lang-zh" lang="zh">相关文章</span></h2>
            </div>
          </div>
          <div class="post-grid related-grid">
            {related.map((item) => (
              <article class="related-card">
                <a href={withBase(`/blog/${slugFor(item)}/`)}>
                  <span class="related-category"><span class="lang-en">{item.data.category}</span><span class="lang-zh" lang="zh">{item.data.categoryZh}</span></span>
                  <h3><span class="lang-en">{item.data.title}</span><span class="lang-zh" lang="zh">{item.data.titleZh}</span></h3>
                  <span class="related-arrow"><Icon name="arrow" size={16} /></span>
                </a>
              </article>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>

  <script>
    const headings = [...document.querySelectorAll('.article-prose h2, .article-prose h3')];
    const toc = document.querySelector('[data-toc]');
    if (toc && headings.length) {
      headings.forEach((heading, index) => {
        if (!heading.id) heading.id = `section-${index + 1}`;
        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent || '';
        if (heading.tagName === 'H3') link.className = 'toc-subitem';
        toc.appendChild(link);
      });
    } else if (toc) {
      toc.innerHTML = '<span class="toc-empty">No sections</span>';
    }
  </script>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.title,
    description: data.summary,
    datePublished: data.date.toISOString(),
    dateModified: (data.updated ?? data.date).toISOString(),
    author: { '@type': 'Person', name: siteConfig.name },
    mainEntityOfPage: canonicalUrl,
  })}></script>
</BaseLayout>
